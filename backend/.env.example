# =========================================================
# PetCare Connect – Backend Environment Variables
# Copy this file to .env and fill in your real values.
# Never commit .env to version control.
# =========================================================

# ---------------------------------------------------------
# Supabase
# ---------------------------------------------------------
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=your_supabase_project_url
# Use the project's anon/public or publishable key. Public API reads work with RLS.
SUPABASE_ANON_KEY=your_supabase_public_or_publishable_key
# Optional: required only for privileged server-side operations. Never use in frontend code.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ---------------------------------------------------------
# Server
# ---------------------------------------------------------
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------
# CORS / Frontend
# ---------------------------------------------------------
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------
# AI chatbot (OpenAI API)
# Keep this key on the backend; never add it to frontend code.
# ---------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: set this to a compatible OpenAI API endpoint.
# OPENAI_API_URL=https://api.openai.com/v1/chat/completions
